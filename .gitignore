.env
.venv/
__pycache__/
*.py[cod]
tmp/


# Reproducible exports: regenerated by the sync/enrich commands and already
# loaded into MySQL. Versioning them would bloat history permanently and some
# exceed GitHub's 50MB warning threshold.
data/gmrepo_all_abundances.csv
data/gmrepo_species_abundances.csv
data/gmrepo_run_abundances*.csv
data/gmrepo_species_retry.csv
data/gmrepo_species_probe.csv
data/gmrepo_probe.csv
data/gmrepo_cmd_followup.csv
data/gmrepo_reload.csv
data/gmrepo_project_samples.csv
data/gmrepo_all_disease_associations.csv
data/mgnify_*.csv
data/ncbi_biosample_demographics.csv

# Large upstream source data, not ours to redistribute
mimedb_microbes_v2.csv
Lit. Reviews/
*.pdf

# Presentation decks - working documents, not part of the pipeline
*.pptx
*.potx

# SQLite build outputs (scripts/build_gutdb_sqlite.py, cleanup_gutdb.py):
# regenerable from the scripts, and the database itself is ~68MB, past GitHub's
# warning threshold.
gut_microbiome.sqlite
gut_microbiome.sqlite-journal
coverage_before_after.csv
cleanup_log.txt
taxdump/

# q1-q7 (scripts/query_gutdb.py) are deliberately TRACKED, though they are
# regenerable. They used to be ignored on that basis, but the script now reads
# MySQL, which changes under you within a session -- abundance rows went from
# 11,884 to over 3M across one stretch of this project. Committing them pins the
# snapshot a given figure or claim was built from, so a number in a slide can be
# traced to a commit instead of to a database that has since moved. ~1MB total.
#
# Regenerate with: python scripts/query_gutdb.py

# Local scratch
tmp/
.DS_Store

# Local Claude Code settings - personal permission grants
.claude/settings.local.json

# Safety copy written by scripts/fix_curated_csv_lineage.py; git holds the original
*.before_lineage_fix

# MicrobiomeHD upstream files (Duvallet et al. 2017) - fetched, not ours to
# redistribute; scripts/load_microbiomehd.py prints the curl commands
data/microbiomehd/

# Muller et al. 2022 curated microbiome-metabolome collection
# (doi:10.1038/s41522-022-00345-5) - fetched by scripts/fetch_muller2022.py,
# upstream data rather than ours to redistribute.
data/muller2022/
